# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/shuttlementor"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_1234567890"
CLERK_SECRET_KEY="sk_test_1234567890"

# Phase 12a — Stripe Connect. Leave blank to boot without Stripe;
# payment surfaces (checkout, refund, webhook) will error when invoked
# until these are filled in. See designFiles/roadmap/phase12-stripe-connect.md.
#
# `STRIPE_SECRET_KEY` is the PLATFORM account's secret key (sk_test_… in dev,
# sk_live_… in prod). Connected accounts are addressed by the `Stripe-Account`
# header at call time, NOT by per-club secret keys.
STRIPE_SECRET_KEY=
# Publishable key fed to the browser by `loadStripe(...)` for Embedded Checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secrets — Stripe issues a DIFFERENT one per endpoint. Both must be
# configured before webhooks accept events (Gap #3: Platform vs Connect tabs).
STRIPE_WEBHOOK_SECRET_PLATFORM=
STRIPE_WEBHOOK_SECRET_CONNECT=
# `true` in prod, `false` in dev. Sanity-checked against every incoming event's
# `livemode` flag — a mismatch returns 400 to Stripe to surface mis-registered
# endpoints (phase12 §8.3).
STRIPE_LIVEMODE=false
# Stripe statement-descriptor brand on the platform side.
STRIPE_PLATFORM_ACCOUNT_NAME=ShuttleMentor

# Phase 12a — absolute base URL used to build Stripe AccountLink
# `return_url` / `refresh_url` (Stripe's AccountLink API rejects path-only
# strings). Falls back to the `app_url` row in `PlatformConfig` when the
# env var is blank (no-SSH workaround §24 / §25).
# Expected values:
#   prod  → https://facilitypresence.com
#   dev   → https://www.dev.facilitypresence.com
#   local → http://localhost:3000
NEXT_PUBLIC_APP_URL=