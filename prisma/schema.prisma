// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// IMPORTANT: When updating field constraints in this schema (like character limits),
// remember to also update the corresponding Zod validation in src/server/api/routers/*.ts
// Current constraints:
// - CoachProfile.bio: max 300 characters
// - CoachProfile.experience: max 1000 characters
// - Profile image size: max 5MB

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Club model - stores club information
model Club {
  clubShortName         String   @id
  clubName              String   @unique
  // Phase 9-EOD (2026-05-02): per-club sequential invoice number counter.
  // Atomically incremented inside the same $transaction as the invoice insert.
  nextInvoiceNumber     Int      @default(1)
  // Phase 10a (2026-05-26): club-level membership settings bag (MembershipPreferences).
  // App-validated JSON, NOT DB columns — shape lives in app code (requireRemarkFor*,
  // billingAnchorMode/billingAnchorDay/prorateFirstTerm/cancelRefundStrategy/
  // prorationRounding, autoGenerateMemberNumbers). Read alongside the club; promote
  // to its own table only if it grows. See designFiles/roadmap/phase10-memberships.md
  // "Membership Preferences".
  membershipPreferences Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users              User[]
  memberships        UserClub[]
  // Per-club member records (legal-isolation boundary). See per-club-profiles.md.
  memberClubProfiles MemberClubProfile[]
  facilities         ClubFacility[]
  resourceTypes      ClubResourceType[]
  resources          ClubResource[]
  calendarEvents     CalendarEvent[]
  products           Product[]
  productCategories  ProductCategory[]
  revenueCategories  RevenueCategory[]
  taxRates           TaxRate[]
  attendances        Attendance[]
  statusLogs         RegistrationStatusLog[]
  packagePlans       PackagePlan[]
  memberPackages     MemberPackage[]
  tags               Tag[]
  rentalBookings     RentalBooking[]
  familyGroups       FamilyGroup[]
  dropInSessions     DropInSession[]
  invoices           Invoice[]
  emailGroups        EmailGroup[]
  auditLogs          AuditLog[]
  // Phase 10a — Memberships
  membershipTypes    MembershipType[]
  membershipPlans    MembershipPlan[]
  memberMemberships  MemberMembership[]
  // Phase 15 Stage 2 — Articles scoped per-club (clubShortName=null is platform)
  articles           Article[]               @relation("ClubArticles")
  articleTags        ArticleTag[]            @relation("ClubArticleTags")
  // Phase 15 Step 6 — Club-scoped short-form announcements feed.
  announcements      ClubAnnouncement[]      @relation("ClubAnnouncements")
  // Phase 12a — Stripe Connect (per-processor connection state). 1:1; club may
  // hold at most one ClubStripeAccount row. Future processors (Paysafe, Valor)
  // get their own tables — `getProviderForClub` resolves the active one.
  stripeAccount      ClubStripeAccount?
  // Phase 12a — local mirror of provider checkout sessions opened against this club.
  checkoutSessions   CheckoutSession[]
  // Phase 12a — dead-letter queue for webhook failures scoped to this club.
  orphanedPurchases  OrphanedPurchase[]
}

// User model - stores profile data locally while using Clerk for auth
model User {
  userId           String        @id @default(cuid())
  clerkUserId      String        @unique // Links to Clerk's user ID
  email            String?
  firstName        String?
  lastName         String?
  profileImage     String?
  userType         UserType      @default(STUDENT)
  timeZone         String        @default("America/New_York")
  clubShortName    String        @default("shuttlementor")
  club             Club          @relation(fields: [clubShortName], references: [clubShortName])
  activeFacilityId String? // Currently active facility — determines calendar view
  activeFacility   ClubFacility? @relation(fields: [activeFacilityId], references: [facilityId])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  studentProfile      StudentProfile?
  coachProfile        CoachProfile?
  videoCollections    VideoCollection[]
  uploadedCollections VideoCollection[] @relation("UploadedBy")
  assignedCollections VideoCollection[] @relation("AssignedCoach")
  coachingNotes       MediaCoachNote[]

  // Calendaring relations
  createdCalendarEvents CalendarEvent[]
  createdProducts       Product[]               @relation("CreatedProducts")
  eventRegistrations    EventRegistration[]     @relation("EventRegistrations")
  attendances           Attendance[]            @relation("MemberAttendances")
  performedCheckins     Attendance[]            @relation("CheckedInByUser")
  statusLogsAffected    RegistrationStatusLog[] @relation("StatusLogUser")
  statusLogsPerformed   RegistrationStatusLog[] @relation("StatusLogChangedBy")
  memberPackages        MemberPackage[]         @relation("MemberPackageOwner")
  soldPackages          MemberPackage[]         @relation("MemberPackageSeller")

  // Phase 9-EOD invoicing relations (Round 4: closedInvoices added; Round 5: billedInvoices added)
  invoices              Invoice[]         @relation("InvoiceMember")
  createdInvoices       Invoice[]         @relation("InvoiceCreatedBy")
  closedInvoices        Invoice[]         @relation("InvoiceClosedBy")
  // Phase 9a Round 5 — invoices where this user is the "Bill to" target
  // (the payer), regardless of who consumed the charges (the `userId` /
  // "member"). When billedToUserId is null, the consumer is also the payer.
  billedInvoices        Invoice[]         @relation("InvoiceBilledTo")
  receivedPayments      InvoicePayment[]  @relation("PaymentReceivedBy")
  issuedRefunds         InvoiceRefund[]   @relation("RefundIssuedBy")
  // Phase 9a line-item hardening — CREDIT lines that snapshot this user as the
  // source payer (whose carried-forward overpayment credit they represent).
  creditSourceLineItems InvoiceLineItem[] @relation("LineItemCreditFromUser")
  // Phase 9b — invoice PDF renders this user triggered.
  generatedInvoicePdfs  InvoicePdf[]      @relation("InvoicePdfGeneratedBy")

  // Phase 10a — Memberships (member is the beneficiary; staff sold it).
  memberMemberships MemberMembership[] @relation("MemberMembershipOwner")
  soldMemberships   MemberMembership[] @relation("MemberMembershipSeller")

  // Audit log (Option B) — actions this user performed + entries about them.
  auditActionsPerformed AuditLog[] @relation("AuditActor")
  auditEntriesAbout     AuditLog[] @relation("AuditTarget")

  // Multi-club membership registry
  clubMemberships UserClub[]

  // Per-club member records — one row per club this user belongs to (legal-isolation
  // boundary; replaces the global StudentProfile.profileData blob). See per-club-profiles.md.
  memberClubProfiles MemberClubProfile[]

  // User tags
  userTags UserTag[]

  rentalBookings RentalBooking[]

  // Drop-in check-ins (designFiles/drop-in) — per-session play state, separate from EventRegistration
  dropInCheckIns               DropInCheckIn[]
  dropInAssignmentParticipants DropInAssignmentParticipant[]

  // Family group — opt-in grouping for shared package consumption (public-shop.md FAM phase).
  // Two users with the same non-null familyGroupId share package credits via consumeCredit widening.
  // Cross-club: a user in two clubs can be in two independent FamilyGroups (one per club).
  familyGroupId String?
  familyGroup   FamilyGroup? @relation(fields: [familyGroupId], references: [familyGroupId], onDelete: SetNull)

  // Date of birth — promoted from StudentProfile.profileData JSON blob for indexed age-range queries
  dateOfBirth DateTime?

  // Gender — set-once (immutable for the user once set), required at onboarding (B1).
  // Feeds GBR's rating category; mapped to GBR's lowercase male/female at provision.
  gender Gender?

  // Articles (Facility Presence marketing articles) — author bio shown on article pages, plus authored articles
  authorBio     String?            @db.Text
  articles      Article[]          @relation("ArticleAuthor")
  // Phase 15 Step 6 — Authored club announcements (collaborative edit within club; Q10).
  announcements ClubAnnouncement[] @relation("AnnouncementAuthor")

  // Email groups
  emailGroupsCreated   EmailGroup[]          @relation("EmailGroupCreator")
  emailGroupMembers    EmailGroupMember[]    @relation("EmailGroupMemberships")
  emailGroupExclusions EmailGroupExclusion[] @relation("EmailGroupExclusions")
  emailsSent           EmailSendLog[]        @relation("EmailSender")
  emailsReceived       EmailSendRecipient[]  @relation("EmailRecipient")

  // Phase 12a — per-processor Customer mapping rows for this user (one row per
  // (processor, connected-account) combo). Populated by the webhook on first
  // checkout; 12b SetupIntents hang saved cards off these rows.
  processorCustomers ProcessorCustomerLink[] @relation("UserProcessorCustomers")

  // Phase 12a Round 2.7.1 — CheckoutSessions this user initiated (the actor who
  // clicked "Pay"), distinct from `consumerUserId` (the beneficiary). For a
  // parent paying for a kid's membership: initiatedByUserId=parent,
  // consumerUserId=kid. The §7.8.13 resume-checkout banner queries by initiator
  // so the parent sees their own in-flight checkout, not the kid's.
  initiatedCheckoutSessions CheckoutSession[] @relation("CheckoutSessionInitiator")

  @@index([clerkUserId])
  @@index([clubShortName])
  @@index([activeFacilityId])
  @@index([familyGroupId])
}

// FamilyGroup — public-shop.md decision #15 (Option D). Members share package credits.
// Admin-only management in v1 (no self-serve invitation flow yet, TD-P6).
// On user delete: see TD-P8 — must call leaveFamilyGroup first; group row deletes when size hits 0.
model FamilyGroup {
  familyGroupId String   @id @default(cuid())
  clubShortName String
  club          Club     @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  name          String? // editable; auto-defaults to "{lastName} family" from first member
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members User[]

  @@index([clubShortName])
}

enum UserType {
  STUDENT
  COACH
  FACILITY
  CLUB_ADMIN
  PLATFORM_ADMIN
}

// Gender — matches GBR's `gender_type` enum ('male','female') for the FP↔GBR stitch.
enum Gender {
  MALE
  FEMALE
}

// UserClub — per-facility membership: one row per user per facility, with facility-specific role.
// User.clubShortName + User.userType + User.activeFacilityId remain the live active fields
// used by all auth logic. Switching facilities updates those fields from the matching UserClub row.
model UserClub {
  id            String   @id @default(cuid())
  userId        String
  clubShortName String
  facilityId    String // The facility this membership grants access to
  role          UserType // Role at this specific facility (e.g., STUDENT at one, FACILITY at another)
  joinedAt      DateTime @default(now())

  user     User         @relation(fields: [userId], references: [userId], onDelete: Cascade)
  club     Club         @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  facility ClubFacility @relation(fields: [facilityId], references: [facilityId], onDelete: Cascade)

  @@unique([userId, facilityId])
  @@index([userId])
  @@index([clubShortName])
  @@index([facilityId])
}

model StudentProfile {
  studentProfileId String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  displayUsername  String?  @unique // Human-readable unique identifier for URLs
  skillLevel       String? // Beginner, Intermediate, Advanced, Professional
  goals            String?  @db.Text
  bio              String?  @db.Text
  profileImage     Bytes? // Store the binary image data directly in PostgreSQL
  profileImageType String? // Store the MIME type (e.g., "image/png")
  // profileData JSON blob removed (per-club-profiles.md PR3 cutover) — its fields
  // moved to per-club MemberClubProfile (phone/medical/allergies/general) and
  // global User.dateOfBirth. skillLevel stays here (global, member-editable).
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CoachProfile {
  coachProfileId   String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  displayUsername  String?  @unique // Human-readable unique identifier for URLs
  bio              String?  @db.VarChar(300) // Short overview, max 300 characters, displayed on coach cards
  experience       String?  @db.VarChar(1000) // Detailed experience, max 1000 characters, for full profile view
  specialties      String[] // Array of specialties
  teachingStyles   String[] // Array of teaching styles
  headerImage      String?
  profileImage     Bytes? // Store the binary image data directly in PostgreSQL
  profileImageType String? // Store the MIME type (e.g., "image/png")  
  rate             Int      @default(0) // Flat rate for coaching sessions
  isActive         Boolean  @default(true) // When false, hidden from coach listings and not assignable
  isVerified       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Per-club member record — everything a single club specifically collects/knows
// about a member, scoped to (userId, clubShortName). THE legal-isolation boundary:
// each club is a separate LLC/data controller, so Club B's staff must never see
// what Club A wrote here. Replaces the global StudentProfile.profileData JSON blob.
// See designFiles/per-club-profiles.md. Grain is CLUB (the LLC), not facility.
// NOTE: skillLevel intentionally NOT here — it stays global + member-editable on
// StudentProfile. dateOfBirth stays global on User. Membership tier lives in
// Phase-10a MemberMembership (fetched by query, not duplicated here).
model MemberClubProfile {
  memberClubProfileId String @id @default(cuid())
  userId              String
  user                User   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  clubShortName       String
  club                Club   @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)

  // Contact (per-club; staff- or member-editable). Caps match the app-level
  // validation that the old studentProfileDataSchema enforced.
  phone                        String? @db.VarChar(32)
  streetAddress                String? @db.VarChar(200)
  city                         String? @db.VarChar(100)
  state                        String? @db.VarChar(50)
  zipCode                      String? @db.VarChar(20)
  emergencyContactName         String? @db.VarChar(120)
  emergencyContactPhone        String? @db.VarChar(32)
  emergencyContactRelationship String? @db.VarChar(50)

  // Marketing attribution (set at join)
  referralSource String? @db.VarChar(120)
  howHeard       String? @db.VarChar(120)

  // Operational / sensitive (staff-authored; the isolation-sensitive fields)
  medicalNotes String? @db.VarChar(2000)
  allergies    String? @db.VarChar(1000)
  generalNotes String? @db.VarChar(5000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clubShortName])
  @@index([userId])
  @@index([clubShortName])
}

model Post {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// Enum for media types in video collections
enum MediaType {
  URL_VIDEO
  FILE_VIDEO
}

enum MediaCoachNoteType {
  TEXT
  YOUTUBE
}

// VideoCollection model - represents a collection of gameplay videos
model VideoCollection {
  collectionId     String    @id @default(cuid())
  userId           String // Links to the user that owns this collection
  user             User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  uploadedByUserId String?
  uploadedByUser   User?     @relation("UploadedBy", fields: [uploadedByUserId], references: [userId], onDelete: SetNull)
  title            String
  description      String?   @db.Text
  mediaType        MediaType // Either URL_VIDEO or FILE_VIDEO
  assignedCoachId  String? // Optional coach assignment
  assignedCoach    User?     @relation("AssignedCoach", fields: [assignedCoachId], references: [userId], onDelete: SetNull)
  isDeleted        Boolean   @default(false) // Soft deletion flag
  deletedAt        DateTime? // When the item was soft-deleted
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  media Media[]

  @@index([userId])
  @@index([isDeleted])
  @@index([assignedCoachId])
  @@index([uploadedByUserId])
}

// Media model - represents individual videos in a collection
model Media {
  mediaId      String          @id @default(cuid())
  collectionId String
  collection   VideoCollection @relation(fields: [collectionId], references: [collectionId], onDelete: Cascade)
  title        String
  description  String?         @db.Text
  // For URL videos
  videoUrl     String?
  // For file videos
  fileKey      String? // Storage key for uploaded files
  fileName     String?
  fileSize     Int? // Size in bytes
  duration     Int? // Duration in seconds
  thumbnailUrl String?
  isDeleted    Boolean         @default(false) // Soft deletion flag
  deletedAt    DateTime? // When the item was soft-deleted
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  coachingNotes MediaCoachNote[]

  @@index([collectionId])
  @@index([isDeleted])
}

// MediaCoachNote model - links Media items with Coach feedback and timestamps
model MediaCoachNote {
  noteId      String             @id @default(cuid())
  mediaId     String
  media       Media              @relation(fields: [mediaId], references: [mediaId], onDelete: Cascade)
  coachId     String // References User.userId where userType is COACH or ADMIN
  coach       User               @relation(fields: [coachId], references: [userId], onDelete: Cascade)
  noteType    MediaCoachNoteType @default(TEXT)
  noteContent String?            @db.VarChar(2000) // Maximum 2000 characters for coaching note content
  videoUrl    String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([mediaId])
  @@index([coachId])
}

// ============================================================
// CALENDARING MODELS
// ============================================================

// Enums for calendaring feature

enum EventType {
  BLOCK // Internal scheduling (maintenance, reserved, staff-only)
  BOOKABLE // Facility-created bookable event (drop-in, league, open gym)
  COACHING_SLOT // Coach-created training slot
  RENTAL_WINDOW // Facility-defined rentable time window
  RENTAL_BOOKING // Member booking within a rental window
  DROP_IN // Managed drop-in session reserving N courts; mode set on DropInSession (designFiles/drop-in)
}

enum RegistrationType {
  PER_INSTANCE // Sign up for individual occurrences (drop-in)
  PER_SERIES // Sign up for the whole series (league)
}

enum RegistrationStatus {
  REGISTERED // Active registration, credit consumed at registration time
  CHECKED_IN // Member attended — no credit change (credit already consumed at REGISTERED).
  // Walk-in check-in (was never REGISTERED) deducts credit at check-in time (Phase 8a, checkin.ts:631-642).
  EARLY_CANCEL // Cancelled before earlyCancelCutoffHours — credit returned (deferred from MVP, see decision #26)
  LATE_CANCEL // Cancelled after cutoff — credit forfeited
  RESCHEDULED // Admin rescheduled — credit transfers to new registration (no new deduction, decision #25/#53)
  NO_SHOW // Did not attend — credit forfeited
}

// ProductCategory — hierarchical, club-scoped product categories (replaces the old ProductCategory enum)
model ProductCategory {
  categoryId       String            @id @default(cuid())
  clubShortName    String
  club             Club              @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  name             String            @db.VarChar(200)
  parentCategoryId String?
  parent           ProductCategory?  @relation("CategoryTree", fields: [parentCategoryId], references: [categoryId])
  children         ProductCategory[] @relation("CategoryTree")
  sortOrder        Int               @default(0)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  revenueCategoryId String?
  revenueCategory   RevenueCategory? @relation(fields: [revenueCategoryId], references: [revenueCategoryId])
  taxRateId         String?
  taxRate           TaxRate?         @relation(fields: [taxRateId], references: [taxRateId])
  products          Product[]

  @@unique([clubShortName, name, parentCategoryId])
  @@index([clubShortName])
  @@index([parentCategoryId])
}

// RevenueCategory — hierarchical revenue classification for reporting (Phase 5c — stub only in 5a)
model RevenueCategory {
  revenueCategoryId String            @id @default(cuid())
  clubShortName     String
  club              Club              @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  code              String            @db.VarChar(50)
  label             String            @db.VarChar(200)
  parentId          String?
  parent            RevenueCategory?  @relation("RevCatTree", fields: [parentId], references: [revenueCategoryId])
  children          RevenueCategory[] @relation("RevCatTree")
  remarks           String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  productCategories ProductCategory[]
  products          Product[]
  invoiceLineItems  InvoiceLineItem[]
  // Phase 10a — Memberships
  membershipTypes   MembershipType[]

  @@unique([clubShortName, code])
  @@index([clubShortName])
  @@index([parentId])
}

// TaxRate — tax rate configuration (Phase 5b — stub only in 5a)
model TaxRate {
  taxRateId     String   @id @default(cuid())
  clubShortName String
  club          Club     @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  code          String   @db.VarChar(50)
  label         String   @db.VarChar(200)
  rate          Decimal  @db.Decimal(5, 2) // Percentage, e.g. 8.25
  effectiveDate DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  productCategories ProductCategory[]
  products          Product[]

  @@unique([clubShortName, code])
  @@index([clubShortName])
}

// ClubResourceType — per-club custom resource types (e.g., "Court", "Swim Lane", "Field")
model ClubResourceType {
  resourceTypeId  String   @id @default(cuid())
  clubShortName   String
  club            Club     @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  name            String   @db.VarChar(100) // e.g., "Court", "Swim Lane", "Field"
  color           String?  @db.VarChar(20) // Default hex color for resources of this type
  backgroundColor String?  @db.VarChar(20) // Default background hex color
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  resources ClubResource[]

  @@unique([clubShortName, name]) // No duplicate type names within a club
  @@index([clubShortName])
}

// ClubFacility — a physical location belonging to a club (e.g., "Downtown Hall", "Suburban Centre")
// Facilities are soft-deleted via isActive = false, never hard-deleted.
model ClubFacility {
  facilityId    String   @id @default(cuid())
  clubShortName String
  club          Club     @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  name          String   @db.VarChar(200)
  streetAddress String?  @db.VarChar(500)
  city          String?  @db.VarChar(100)
  state         String?  @db.VarChar(100)
  zipCode       String?  @db.VarChar(20)
  phone         String?  @db.VarChar(30)
  email         String?  @db.VarChar(255)
  timezone      String   @default("America/New_York")
  isActive      Boolean  @default(true)
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  activeUsers       User[] // Users currently viewing this facility
  memberships       UserClub[] // Per-facility membership rows
  resources         ClubResource[]
  calendarEvents    CalendarEvent[]
  attendances       Attendance[]
  rentalBookings    RentalBooking[]
  invoices          Invoice[]
  emailGroups       EmailGroup[]
  // Phase 10a — Memberships (facility where the membership was sold / member's
  // home location; attribution only, mirrors Invoice.facilityId).
  memberMemberships MemberMembership[]

  @@unique([clubShortName, name])
  @@index([clubShortName])
}

// ClubResource — a physical or logical resource belonging to a club (e.g., "Court 1", "Lane 3")
model ClubResource {
  resourceId      String           @id @default(cuid())
  clubShortName   String
  club            Club             @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  resourceTypeId  String
  resourceType    ClubResourceType @relation(fields: [resourceTypeId], references: [resourceTypeId], onDelete: Restrict)
  facilityId      String? // null = unassigned (visible in "All Facilities" only)
  facility        ClubFacility?    @relation(fields: [facilityId], references: [facilityId], onDelete: Restrict)
  title           String           @db.VarChar(200) // Display name, e.g., "Court 1"
  description     String?          @db.Text
  color           String?          @db.VarChar(20) // Override color (hex), falls back to type color
  backgroundColor String?          @db.VarChar(20) // Override background color (hex)
  position        Int              @default(0) // Display order in calendar
  isActive        Boolean          @default(true) // Soft disable (inactive resources hidden from calendar)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  businessHours  ResourceBusinessHours[]
  events         CalendarEvent[]
  rentalBookings RentalBooking[]

  @@index([clubShortName])
  @@index([resourceTypeId])
  @@index([facilityId])
}

// ResourceBusinessHours — operating hours for a resource; supports split shifts
model ResourceBusinessHours {
  businessHoursId String       @id @default(cuid())
  resourceId      String
  resource        ClubResource @relation(fields: [resourceId], references: [resourceId], onDelete: Cascade)
  daysOfWeek      String[] // e.g., ["monday", "tuesday", "wednesday", "thursday", "friday"]
  startTime       Int // Hour 0-23 (inclusive), e.g., 6 for 6:00 AM
  endTime         Int // Hour 0-23 (exclusive), e.g., 22 for 10:00 PM
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([resourceId])
}

// CalendarEvent — a calendar event, optionally recurring, scoped to a club
model CalendarEvent {
  eventId         String        @id @default(cuid())
  clubShortName   String
  club            Club          @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  resourceId      String?
  resource        ClubResource? @relation(fields: [resourceId], references: [resourceId], onDelete: SetNull)
  facilityId      String
  facility        ClubFacility  @relation(fields: [facilityId], references: [facilityId], onDelete: Restrict)
  title           String        @db.VarChar(500)
  description     String?       @db.Text
  start           DateTime
  end             DateTime
  allDay          Boolean       @default(false)
  color           String?       @db.VarChar(20) // Event text color (hex)
  backgroundColor String?       @db.VarChar(20) // Event background color (hex)

  // iCal / Recurrence fields
  uid               String // Unique iCal UID — same across base event and all its modified instances
  rrule             String?         @db.Text // RFC 5545 RRULE string, e.g., "RRULE:FREQ=WEEKLY;BYDAY=MO;UNTIL=20251231T235959Z"
  exdates           DateTime[] // Exception dates — occurrences to skip (for recurring events)
  recurrenceId      String? // ISO timestamp of the original occurrence this instance overrides (for modified instances)
  parentEventId     String? // FK to the base CalendarEvent (for modified instances)
  parentEvent       CalendarEvent?  @relation("EventInstances", fields: [parentEventId], references: [eventId], onDelete: Cascade)
  modifiedInstances CalendarEvent[] @relation("EventInstances")

  // Bookable event fields (defaults allow V1 code to ignore them)
  eventType              EventType         @default(BLOCK)
  isBlocking             Boolean           @default(true) // Whether this event blocks the resource for conflict detection
  isPublic               Boolean           @default(false) // Whether this event is visible on the public calendar
  showRegistrantNames    Boolean           @default(false) // Whether confirmed registrant names are shown on the public event page
  maxParticipants        Int? // Capacity cap (null = unlimited)
  registrationType       RegistrationType? // PER_INSTANCE (drop-in) or PER_SERIES (league)
  creditCost             Int? // Credits required to check in (Phase 5, null = not credit-based)
  earlyCancelCutoffHours Int? // Hours before event start for early-cancel credit refund (null = use club default)
  maxBookingHours        Int?              @default(2) // Max hours per rental booking session (for RENTAL_WINDOW events)
  productId              String? // FK to Product (null for BLOCK events)
  product                Product?          @relation(fields: [productId], references: [productId], onDelete: SetNull)
  resourceIds            String[] // Additional resource IDs for cross-resource events

  // Metadata
  createdByUserId String
  createdByUser   User      @relation(fields: [createdByUserId], references: [userId], onDelete: Cascade)
  isDeleted       Boolean   @default(false) // Soft deletion
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  registrations        EventRegistration[]
  attendances          Attendance[]
  creditUsages         PackageCreditUsage[]
  rentalWindowBookings RentalBooking[]      @relation("RentalWindow")
  bookingBlockEvent    RentalBooking?       @relation("BookingBlock")
  dropInSessions       DropInSession[]      @relation("DropInEvent")

  @@index([clubShortName])
  @@index([resourceId])
  @@index([facilityId])
  @@index([uid])
  @@index([parentEventId])
  @@index([createdByUserId])
  @@index([isDeleted])
  @@index([start, end]) // For date-range queries
  @@index([eventType])
  @@index([productId])
}

// ===========================================================================
// Drop-In Sessions (designFiles/drop-in). DI-1 adds Session + CheckIn for
// MANUAL mode. TIMED/MATCH add DropInAssignment + DropInAssignmentParticipant
// in DI-2/DI-4.
// ===========================================================================

enum DropInMode {
  TIMED // clock-driven rotation, no scores
  MATCH // matchup-driven; scores -> GBR as self-reported 1.0x
  MANUAL // register/check-in/cancel/waitlist only; no digital match records
}

enum DropInSessionStatus {
  SCHEDULED
  ACTIVE
  PAUSED // staff paused: existing games finish, no new games/joins, no auto-rotate
  ENDED
  CANCELLED
}

enum DropInFormat {
  SINGLES // open 1v1 — any gender vs any gender
  DOUBLES // open 2v2 — any genders pair freely (app-level default for MATCH/TIMED)
  MIXED_DOUBLES // strict 1 male + 1 female per pair (optional formal format; enforced via User.gender)
}

enum DropInPlayerStatus {
  IDLE // checked in, not in the queue — must "join queue" to play (default)
  WAITING // in the queue/pool
  PLAYING // currently on a court
  AWAITING_RESULT // off court; owes/awaits report or confirm (MATCH); gated from queue
  DONE
  LEFT
  CANCELLED
}

// One per event occurrence (day). Materialized lazily on first check-in.
model DropInSession {
  sessionId      String              @id @default(cuid())
  clubShortName  String
  club           Club                @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  eventId        String
  event          CalendarEvent       @relation("DropInEvent", fields: [eventId], references: [eventId], onDelete: Cascade)
  occurrenceDate DateTime // which occurrence of a recurring series (date-only semantics)
  mode           DropInMode
  format         DropInFormat? // null for MANUAL
  status         DropInSessionStatus @default(SCHEDULED)

  courtIds              String[] // snapshot of event.resourceIds dedicated to drop-in
  rotationMinutes       Int? // TIMED: slot length (default 15, max 30, 5-min steps); null otherwise
  matchTimeLimitMinutes Int? // MATCH (DI-6): optional hard cap per match
  bestOf                Int?     @default(3) // MATCH: games per match (best 2-of-3)
  pointsPerGame         Int?     @default(21) // MATCH: points to win a game

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  checkIns    DropInCheckIn[]
  assignments DropInAssignment[]

  @@unique([eventId, occurrenceDate]) // one live session per day per series
  @@index([clubShortName])
  @@index([status])
}

// Per-player session state — SEPARATE from EventRegistration / Attendance.
model DropInCheckIn {
  checkInId String             @id @default(cuid())
  sessionId String
  session   DropInSession      @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [userId])
  status    DropInPlayerStatus @default(IDLE)

  // Fairness ordering inputs (queue derived, not a separate table)
  queuedAt     DateTime  @default(now())
  gamesPlayed  Int       @default(0)
  lastPlayedAt DateTime?

  // GBR linkage resolved lazily (DI-5)
  gbrPlayerId    String?
  // Billing hook (reuse Phase 8a): the registration that covered the fee, if any
  registrationId String?

  checkedInAt DateTime  @default(now())
  leftAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([sessionId, userId])
  @@index([sessionId, status])
  @@index([userId])
}

// ===========================================================================
// DROP-IN ROTATION (TIMED + MATCH) — DI-2 / DI-4. See designFiles/drop-in.
// ===========================================================================

enum DropInSide {
  A
  B
}

enum DropInAssignmentStatus {
  ASSIGNED // transient: staff pre-assign or the instant before auto-start (happy path skips to IN_PROGRESS)
  IN_PROGRESS // the live matchup/group on the court
  PENDING_CONFIRM // MATCH: one side reported a score; court freed; awaiting opponent confirm
  CONFIRMED // MATCH: both sides agree; eligible for GBR sync
  DISPUTED // MATCH: score mismatch; needs staff resolution
  COMPLETED // TIMED slot ended by timer (no scores)
  CANCELLED // staff-cancelled
}

enum GbrSyncStatus {
  NOT_APPLICABLE // TIMED / MANUAL — never synced
  PENDING // confirmed, queued for submission
  SENT // accepted by GBR
  FAILED // submission errored; retry queue re-attempts
  SKIPPED // intentionally not scored (walkover / staff override)
}

// A court occupied by players for a slot (TIMED group) or a matchup (MATCH).
model DropInAssignment {
  assignmentId String                 @id @default(cuid())
  sessionId    String
  session      DropInSession          @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  courtId      String // ClubResource id (one of session.courtIds); plain string, not a relation
  format       DropInFormat
  status       DropInAssignmentStatus @default(ASSIGNED)

  participants DropInAssignmentParticipant[]

  startedAt DateTime?
  endedAt   DateTime?
  expiresAt DateTime? // TIMED: startedAt + rotationMinutes; MATCH (DI-6): optional time limit

  // Scores (MATCH only) — best-of-N per DropInSession.bestOf
  reportedByUserId  String?
  reportedScoreA    Int? // games won by side A (summary/winner)
  reportedScoreB    Int? // games won by side B
  gameScores        Json? // per-game [{a:21,b:18},...] — submitted to GBR match_sets (DI-5)
  winnerSide        DropInSide?
  confirmedByUserId String?
  confirmedAt       DateTime?

  // GBR sync (MATCH only; stubbed until DI-5)
  externalMatchId String?       @unique // idempotency key sent to GBR; == assignmentId
  gbrSyncStatus   GbrSyncStatus @default(NOT_APPLICABLE)
  gbrSyncedAt     DateTime?
  gbrSyncError    String?
  ratingWeight    Float? // 1.0 for self-reported drop-in matches

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, status])
  @@index([courtId])
  @@index([gbrSyncStatus])
}

// Per-player rows for an assignment — the unit we aggregate for standings + fairness.
model DropInAssignmentParticipant {
  id                 String           @id @default(cuid())
  assignmentId       String
  assignment         DropInAssignment @relation(fields: [assignmentId], references: [assignmentId], onDelete: Cascade)
  sessionId          String // denormalized from the assignment for fast per-session aggregation
  userId             String
  user               User             @relation(fields: [userId], references: [userId])
  gbrPlayerId        String? // GBR player id used at submission time
  side               DropInSide? // A/B for MATCH; null for a TIMED group
  isWinner           Boolean? // stamped when the assignment is CONFIRMED (MATCH); null for TIMED
  ratingAtAssignment Float? // optional: GBR display rating used for skill-band pairing (audit)
  createdAt          DateTime         @default(now())

  @@unique([assignmentId, userId])
  @@index([sessionId, userId])
  @@index([userId])
}

// Product — a generic purchasable product
model Product {
  productId         String           @id @default(cuid())
  clubShortName     String
  club              Club             @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  categoryId        String
  category          ProductCategory  @relation(fields: [categoryId], references: [categoryId])
  name              String           @db.VarChar(200)
  description       String?          @db.Text
  sku               String?          @db.VarChar(100)
  priceInCents      Int // Price in cents (0 for free events)
  currency          String           @default("usd") @db.VarChar(3)
  stripeProductId   String?          @unique
  stripePriceId     String?
  revenueCategoryId String?
  revenueCategory   RevenueCategory? @relation(fields: [revenueCategoryId], references: [revenueCategoryId])
  taxRateId         String?
  taxRate           TaxRate?         @relation(fields: [taxRateId], references: [taxRateId])
  isActive          Boolean          @default(true)
  // Public shop fields (public-shop.md decisions #2 + #5).
  // isPubliclyListed: opt-in to appear on /club/[shortname]/shop. Save-handler guard (I3):
  // setting isActive=false auto-flips isPubliclyListed=false.
  isPubliclyListed  Boolean          @default(false)
  publicDescription String?          @db.Text
  publicImageData   Bytes?
  publicImageType   String?
  createdByUserId   String
  createdByUser     User             @relation("CreatedProducts", fields: [createdByUserId], references: [userId])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  calendarEvents   CalendarEvent[]
  registrations    EventRegistration[]
  packagePlans     PackagePlan[]
  rentalBookings   RentalBooking[]
  invoiceLineItems InvoiceLineItem[]

  @@index([clubShortName])
  @@index([categoryId])
  @@index([stripeProductId])
  @@index([createdByUserId])
  @@index([clubShortName, isPubliclyListed])
}

enum RentalBookingStatus {
  CONFIRMED
  CANCELLED
  // NO_SHOW: reserved for a future staff flow (CR-d). No current code path sets this —
  // added now so the migration ships before real data accumulates. Parallels RegistrationStatus.NO_SHOW.
  NO_SHOW
}

model RentalBooking {
  bookingId               String              @id @default(cuid())
  clubShortName           String
  club                    Club                @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  facilityId              String
  facility                ClubFacility        @relation(fields: [facilityId], references: [facilityId])
  rentalWindowEventId     String
  rentalWindowEvent       CalendarEvent       @relation("RentalWindow", fields: [rentalWindowEventId], references: [eventId])
  userId                  String
  user                    User                @relation(fields: [userId], references: [userId])
  resourceId              String
  resource                ClubResource        @relation(fields: [resourceId], references: [resourceId])
  startTime               DateTime
  endTime                 DateTime
  blockingEventId         String?             @unique // @unique required for 1:1 relation (decision #69)
  blockingEvent           CalendarEvent?      @relation("BookingBlock", fields: [blockingEventId], references: [eventId])
  productId               String?
  product                 Product?            @relation(fields: [productId], references: [productId])
  status                  RentalBookingStatus @default(CONFIRMED)
  notes                   String?
  // Phase 12a — Stripe Connect traceability for paid rental bookings (CR-b).
  // Null for staff-booked / cash-at-desk bookings.
  stripeCheckoutSessionId String?             @unique
  stripePaymentIntentId   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([clubShortName])
  @@index([rentalWindowEventId])
  @@index([userId])
  @@index([resourceId])
  @@index([startTime, endTime])
  @@index([status])
  @@index([stripePaymentIntentId])
}

// EventRegistration — tracks who signed up for what; created when Stripe webhook confirms payment
// NOTE: No DB-level unique constraint on [eventId, userId, instanceDate] — enforced in app logic only.
// This allows re-booking after cancellation without constraint violations.
model EventRegistration {
  registrationId          String             @id @default(cuid())
  eventId                 String
  event                   CalendarEvent      @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  productId               String?
  product                 Product?           @relation(fields: [productId], references: [productId])
  userId                  String
  user                    User               @relation("EventRegistrations", fields: [userId], references: [userId])
  instanceDate            DateTime? // For PER_INSTANCE (drop-in): the specific occurrence date
  // Phase 12a — `@unique` added (row-level idempotency for webhook attach).
  // Pairs with `ProcessedProcessorEvent` (event-level idempotency).
  stripeCheckoutSessionId String?            @unique // Stripe Checkout session ID for traceability
  stripePaymentIntentId   String? // Stripe PaymentIntent ID for traceability
  status                  RegistrationStatus @default(REGISTERED)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Relations
  attendances      Attendance[]
  statusLogs       RegistrationStatusLog[]
  creditUsages     PackageCreditUsage[]
  invoiceLineItems InvoiceLineItem[]

  @@index([eventId])
  @@index([productId])
  @@index([userId])
  @@index([stripeCheckoutSessionId])
  @@index([stripePaymentIntentId])
}

// ============================================================
// CHECK-IN & AUDIT LOG MODELS
// ============================================================

// Attendance — lightweight check-in log. Does NOT replace EventRegistration.
// EventRegistration = billing state machine. Attendance = operational log of arrivals.
model Attendance {
  attendanceId    String             @id @default(cuid())
  clubShortName   String
  club            Club               @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  facilityId      String
  facility        ClubFacility       @relation(fields: [facilityId], references: [facilityId])
  userId          String // the member who arrived
  user            User               @relation("MemberAttendances", fields: [userId], references: [userId])
  eventId         String? // null = general facility check-in (open court play)
  event           CalendarEvent?     @relation(fields: [eventId], references: [eventId])
  registrationId  String? // links to EventRegistration when checking into a registered event
  registration    EventRegistration? @relation(fields: [registrationId], references: [registrationId])
  checkedInBy     String // staff userId who performed check-in, or member's own userId for self-check-in
  checkedInByUser User               @relation("CheckedInByUser", fields: [checkedInBy], references: [userId])
  checkedInAt     DateTime           @default(now())
  source          String // "staff" | "self" | "scan"
  notes           String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  creditUsages PackageCreditUsage[]

  @@index([clubShortName])
  @@index([facilityId])
  @@index([userId])
  @@index([eventId])
  @@index([checkedInAt])
}

// RegistrationStatusLog — audit log for all registration status changes (Option A, MVP)
model RegistrationStatusLog {
  logId           String              @id @default(cuid())
  clubShortName   String
  club            Club                @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  registrationId  String
  registration    EventRegistration   @relation(fields: [registrationId], references: [registrationId])
  userId          String // the member affected
  user            User                @relation("StatusLogUser", fields: [userId], references: [userId])
  changedByUserId String // staff or system who made the change
  changedByUser   User                @relation("StatusLogChangedBy", fields: [changedByUserId], references: [userId])
  oldStatus       RegistrationStatus? // null for initial creation
  newStatus       RegistrationStatus
  source          String? // "admin_dashboard" | "self_service" | "system"
  reason          String?             @db.Text
  metadata        Json?
  createdAt       DateTime            @default(now())

  @@index([clubShortName])
  @@index([registrationId])
  @@index([userId])
  @@index([changedByUserId])
  @@index([createdAt])
}

// AuditLog — broad, owner-facing action log (Option B; phase7-admin-checkin.md
// §"Audit Log"). APPEND-ONLY: never expose update/delete on this table. Written
// in-transaction via the `writeAuditedMutation` wrapper
// (src/server/utils/auditedMutation.ts) so audit rows commit atomically with the
// action that produced them. Entity is referenced by STRING type+id (no FK) so
// the log survives record deletion and needs no migration per new entity type.
//
// Multi-party (bill-to): one logical action writes TWO rows — one per affected
// user (`targetRole` "consumer"/"payer") — sharing a `correlationId` so the
// global feed can collapse them while each member's Activity tab shows its row.
// Non-human actors (cron / webhook / ai_agent / system) set actorUserId = null
// plus a non-human `source`. RegistrationStatusLog stays separate for now
// (registration changes); consolidation is deferred to the Activity-tab UI.
model AuditLog {
  logId         String @id @default(cuid())
  clubShortName String
  club          Club   @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)

  actorUserId String? // null for non-human actors (see `source`)
  actorUser   User?   @relation("AuditActor", fields: [actorUserId], references: [userId])
  source      String // "admin_dashboard"|"self_service"|"system"|"cron"|"ai_agent"|"webhook"

  targetUserId  String? // the member this row is "about" (null for non-member actions)
  targetUser    User?   @relation("AuditTarget", fields: [targetUserId], references: [userId])
  targetRole    String? // "consumer"|"payer"|null — which party this row represents (bill-to)
  correlationId String? // shared across the rows of one logical action (multi-party)

  action     String // dot-notation constant — see AUDIT_ACTIONS
  entityType String // model name as a string, e.g. "Invoice", "InvoicePayment"
  entityId   String // PK of the affected record (no FK — append-only, deletion-safe)
  dedupeKey  String? // idempotency for processor-webhook retries (Phase 11); null = no dedupe
  metadata   Json     @default("{}") // structured context (amounts, invoice #, old/new, …)
  createdAt  DateTime @default(now())

  @@unique([clubShortName, dedupeKey])
  @@index([clubShortName, targetUserId, createdAt(sort: Desc)])
  @@index([clubShortName, createdAt(sort: Desc)])
  @@index([clubShortName, entityType, entityId])
  @@index([actorUserId])
  @@index([correlationId])
}

// ============================================================
// PACKAGES & CREDITS (Phase 8a)
// ============================================================

// PackagePlan — a template for a bundle of credits/sessions that can be sold to members.
// Exactly one of productId or isGeneralDropIn=true must be set (enforced in business logic).
model PackagePlan {
  packagePlanId     String   @id @default(cuid())
  clubShortName     String
  club              Club     @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  productId         String? // null when isGeneralDropIn = true
  product           Product? @relation(fields: [productId], references: [productId])
  isGeneralDropIn   Boolean  @default(false) // if true: deduct at any facility check-in (open court play)
  name              String   @db.VarChar(200)
  description       String?  @db.Text
  sessionCount      Int? // null = unlimited (deferred to 8b)
  priceInCents      Int // Stripe-native: amount in smallest currency unit
  durationValue     Int? // e.g., 1, 3, 6, 12 (null = no expiry)
  durationUnit      String?  @db.VarChar(20) // "days" | "weeks" | "months" | "years" (null = no expiry)
  autoRenew         Boolean  @default(false) // deferred to 8c
  isActive          Boolean  @default(true)
  // Public shop fields (public-shop.md decisions #2 + #5 + #17).
  // PackagePlans are first-class Stripe SKUs (decision #17) — distinct from product.stripePriceId.
  // Save-handler guard (I3): isActive=false auto-flips isPubliclyListed=false.
  isPubliclyListed  Boolean  @default(false)
  publicDescription String?  @db.Text
  publicImageData   Bytes?
  publicImageType   String?
  // Phase 12a — `@unique` added (deferred from public-shop v1 / decision #17).
  // Always null until Phase C populates them; no duplicate-value risk.
  stripeProductId   String?  @unique
  stripePriceId     String?  @unique
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberPackages   MemberPackage[]
  invoiceLineItems InvoiceLineItem[]

  @@index([clubShortName])
  @@index([productId])
  @@index([clubShortName, isPubliclyListed])
}

// MemberPackage — an instance of a PackagePlan sold to a specific member.
model MemberPackage {
  memberPackageId         String      @id @default(cuid())
  clubShortName           String
  club                    Club        @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  userId                  String
  user                    User        @relation("MemberPackageOwner", fields: [userId], references: [userId])
  packagePlanId           String
  packagePlan             PackagePlan @relation(fields: [packagePlanId], references: [packagePlanId])
  startDate               DateTime
  endDate                 DateTime? // calculated at sale time using facility timezone; null = no expiry
  creditsTotal            Int? // null = unlimited (deferred to 8b)
  creditsUsed             Int         @default(0)
  status                  String      @db.VarChar(20) // "active" | "depleted" | "expired" (cancelled deferred)
  soldBy                  String // staff userId who sold it
  soldByUser              User        @relation("MemberPackageSeller", fields: [soldBy], references: [userId])
  soldAt                  DateTime    @default(now())
  invoiceId               String? // Phase 9-EOD (2026-05-02): populated for new sales; null for historical rows.
  invoice                 Invoice?    @relation(fields: [invoiceId], references: [invoiceId])
  // Phase 12a — Stripe Connect traceability. Populated when a package was sold
  // via the embedded checkout / webhook path; null for staff-sold packages.
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId   String?
  notes                   String?     @db.Text
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  creditUsages     PackageCreditUsage[]
  invoiceLineItems InvoiceLineItem[]

  @@index([clubShortName])
  @@index([userId])
  @@index([packagePlanId])
  @@index([status])
  @@index([endDate])
  @@index([invoiceId])
  @@index([stripePaymentIntentId])
}

// PackageCreditUsage — records a single credit deduction from a MemberPackage.
model PackageCreditUsage {
  usageId         String             @id @default(cuid())
  memberPackageId String
  memberPackage   MemberPackage      @relation(fields: [memberPackageId], references: [memberPackageId], onDelete: Cascade)
  eventId         String? // null for general facility check-ins (no specific event)
  event           CalendarEvent?     @relation(fields: [eventId], references: [eventId])
  registrationId  String? // set when credit deducted at registration (primary path)
  registration    EventRegistration? @relation(fields: [registrationId], references: [registrationId])
  attendanceId    String? // set when credit deducted at check-in (walk-in or general)
  attendance      Attendance?        @relation(fields: [attendanceId], references: [attendanceId])
  creditsConsumed Int // from event.creditCost (or 1 for general check-ins)
  createdAt       DateTime           @default(now())

  @@index([memberPackageId])
  @@index([registrationId])
  @@index([attendanceId])
  @@index([eventId])
}

// ============================================================
// USER TAGS
// ============================================================

// Tag — club-scoped label that can be assigned to users (e.g., "Beginner", "VIP", "League Player")
model Tag {
  tagId         String   @id @default(cuid())
  clubShortName String
  club          Club     @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  name          String   @db.VarChar(50)
  bgColor       String   @db.VarChar(20)
  textColor     String   @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userTags UserTag[]

  @@unique([clubShortName, name])
  @@index([clubShortName])
}

// UserTag — many-to-many join between User and Tag
model UserTag {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [tagId], onDelete: Cascade)

  @@unique([userId, tagId])
  @@index([userId])
  @@index([tagId])
}

// ============================================================
// INVOICING (Phase 9-EOD, 2026-05-02)
// See designFiles/roadmap/phase9-invoicing.md for design + decisions.
// ============================================================

// Invoice — a billable document for one member. v1 ships invoice-per-package-sale
// (sellPackage creates one finalized invoice with one line item). Schema also
// supports the running-tab shape (multi-line, draft → open → paid) for future.
model Invoice {
  invoiceId         String        @id @default(cuid())
  clubShortName     String
  club              Club          @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  invoiceNumber     String // human-readable, e.g., "INV-000042"; sequential per club
  userId            String // the "member" / consumer — whose MemberPackages and check-ins these charges relate to
  user              User          @relation("InvoiceMember", fields: [userId], references: [userId])
  // Phase 9a Round 5 — optional "Bill to" override. When set, this is the
  // user who OWES the invoice (the payer), which may differ from `userId`
  // (the consumer). Common case: a parent (billedToUserId) paying for a
  // child's classes (userId). NULL means "same as userId" — the consumer
  // pays for themselves (Phase 9a Rounds 1–4 default behavior, preserved
  // for all existing invoices). Set at invoice creation, never mutated
  // after — changing who-owes mid-flight creates audit confusion.
  //
  // Used by:
  // - `sellPackage`'s running-tab find + credit-pull (keyed off the
  //   effective payer = COALESCE(billedToUserId, userId)).
  // - `billing.getMemberBilling`'s widened invoice list (returns invoices
  //   where the viewed user is EITHER the consumer OR the payer).
  // - Future PDF generation (Phase 13) — "Bill To" section uses this.
  billedToUserId    String?
  // `onDelete: SetNull` matches what the original migration already applied
  // at the DB level — declared here in the schema so future `prisma migrate
  // dev` runs don't generate a "fix" migration that would change behavior.
  // If a payer User is ever deleted, their bill-to invoices retroactively
  // become "self-pay" in the data (the audit-trail of who-paid is lost —
  // revisit when a user-delete feature actually ships).
  billedToUser      User?         @relation("InvoiceBilledTo", fields: [billedToUserId], references: [userId], onDelete: SetNull)
  facilityId        String?
  facility          ClubFacility? @relation(fields: [facilityId], references: [facilityId])
  status            String        @db.VarChar(20) // STORED: "draft" | "open" | "partially_paid" | "paid" | "void". "due"/"overdue" are DERIVED at display from closedAt + dueDate + balance (src/lib/invoiceStatus.ts) — never stored.
  issueDate         DateTime      @default(now())
  dueDate           DateTime?
  // Money in cents (matches existing priceInCents pattern). No Decimal.
  subtotalInCents   Int
  taxTotalInCents   Int           @default(0)
  totalInCents      Int
  // amountPaidInCents is net of refunds: sum(payments.amount) - sum(refunds.amount).
  // Outstanding balance is computed at query time as totalInCents - amountPaidInCents.
  amountPaidInCents Int           @default(0)
  notes             String?       @db.Text
  createdBy         String // staff userId
  createdByUser     User          @relation("InvoiceCreatedBy", fields: [createdBy], references: [userId])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Phase 9a Round 4 — close-tab + credit carry-forward.
  // closedAt is set when either (a) `closeInvoice` mutation runs manually on a
  // non-paid invoice, or (b) `recordPayment` flips status to "paid" (auto-close
  // in the same transaction). Once closedAt is non-null, `sellPackage` does NOT
  // append new line items to this invoice — a fresh invoice opens for the next
  // charge. See designFiles/roadmap/phase9-invoicing.md.
  closedAt              DateTime?
  closedBy              String?
  closedByUser          User?     @relation("InvoiceClosedBy", fields: [closedBy], references: [userId])
  // creditConsumedAt is stamped when this (auto-closed + overpaid) invoice's
  // overpayment credit has been FULLY consumed — either pulled forward as a
  // "Credit from INV-XXX" line on a new invoice (sellPackage), or drawn down to
  // zero by manual Account-Credit applications. NULL = credit still (partly)
  // available. Pair with `creditConsumedInCents` for partial draw-downs.
  creditConsumedAt      DateTime?
  // How much of this invoice's overpayment credit has been spent so far (across
  // one or more Account-Credit applications / carry-forwards). Available credit
  // from this invoice = (amountPaidInCents - totalInCents) - creditConsumedInCents.
  // When that hits 0, `creditConsumedAt` is stamped. Always 0 for invoices that
  // were never overpaid.
  creditConsumedInCents Int       @default(0)

  // Phase 12a — set when the invoice-pay-now flow creates a checkout session
  // targeting THIS specific invoice. `@unique` is the row-level idempotency
  // lock during webhook attach (pairs with `ProcessedProcessorEvent` at the
  // event level). Null for non-Stripe / manual invoices.
  stripeCheckoutSessionId String? @unique

  lineItems                InvoiceLineItem[]
  payments                 InvoicePayment[]
  refunds                  InvoiceRefund[]
  memberPackages           MemberPackage[]
  // Back-relation: line items on OTHER invoices that pulled credit from this one.
  creditAppliedToLineItems InvoiceLineItem[] @relation("CreditSource")
  // Phase 9b — cached PDF renders (one row per render, latest version is served).
  invoicePdfs              InvoicePdf[]

  @@unique([clubShortName, invoiceNumber])
  @@index([clubShortName])
  @@index([userId])
  @@index([clubShortName, userId])
  @@index([status])
  @@index([facilityId])
  @@index([createdBy])
  @@index([closedAt])
  @@index([creditConsumedAt])
  // Phase 9a Round 5 — fast lookup for "invoices billed to this user"
  // (BillingPanel widening + future "/clients/[userId]/billed-to" filters).
  @@index([billedToUserId])
  @@index([clubShortName, billedToUserId])
}

// InvoiceLineItem — a single charge on an invoice. unitPriceInCents is a SNAPSHOT
// at invoice creation time so historical totals are immune to later plan-price edits.
// Phase 9a line-item hardening — closed, code-controlled discriminator for what
// a line represents. Enum (not String) because the value set is small + fixed by
// us and feeds reporting GROUP BY + exhaustive switch rendering. (Contrast
// Invoice.status / InvoicePayment.processor — String because they're
// configurable / open-ended.) Adding a value = a one-line enum migration.
enum InvoiceLineItemKind {
  PACKAGE_SALE // sold PackagePlan (productId + packagePlanId + memberPackageId set)
  CREDIT // overpayment credit carried forward (creditFromInvoiceId set; negative amount)
  PRODUCT_SALE // a Product sold directly (productId only) — future (E19 / POS)
  FEE // ad-hoc charge, no provenance FK — future
  EVENT_REGISTRATION // billable event check-in w/o a covering package — future (E18)
  RENTAL // court-rental charge — future
  MEMBERSHIP_FEE // recurring membership charge — future (Phase 10; adds memberMembershipId)
}

model InvoiceLineItem {
  lineItemId        String              @id @default(cuid())
  invoiceId         String
  invoice           Invoice             @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  // Phase 9a line-item hardening — explicit discriminator. Producers set this
  // alongside the matching provenance FK(s); do NOT infer the type from which FK
  // is non-null (productId is set on BOTH PACKAGE_SALE and PRODUCT_SALE lines, so
  // the FK pattern is ambiguous). The DB can't enforce "kind matches the FK set"
  // (cross-column rule) — sellPackage + future producers assert it in app code.
  kind              InvoiceLineItemKind
  productId         String?
  product           Product?            @relation(fields: [productId], references: [productId])
  packagePlanId     String?
  packagePlan       PackagePlan?        @relation(fields: [packagePlanId], references: [packagePlanId])
  memberPackageId   String?
  memberPackage     MemberPackage?      @relation(fields: [memberPackageId], references: [memberPackageId])
  description       String              @db.VarChar(500)
  // quantity = how many of THIS line unit (e.g. 2 drinks). For a package sale it
  // is always 1 — the session COUNT lives on PackagePlan.sessionCount /
  // MemberPackage.creditsTotal, NOT here.
  quantity          Int                 @default(1)
  // unitPriceInCents = SNAPSHOT of what was charged per unit at creation;
  // authoritative. NOT the same as the linked Product/PackagePlan price (those
  // can drift later; this can't). Negative on CREDIT lines.
  unitPriceInCents  Int
  discountInCents   Int                 @default(0)
  // Tax stored as basis points (1bp = 0.01%); 0 = no tax. Snapshot at creation.
  taxRateBps        Int                 @default(0)
  taxAmountInCents  Int                 @default(0)
  // Phase 9a line-item hardening — SNAPSHOT the revenue category at creation
  // (decision #5/Q3). Was derived live via productId -> Product.revenueCategoryId
  // (drifts on recategorization). Tax was already snapshotted; this makes revenue
  // classification consistent. Null when no category (credit lines, ad-hoc fees,
  // isGeneralDropIn packages with no product).
  revenueCategoryId String?
  revenueCategory   RevenueCategory?    @relation(fields: [revenueCategoryId], references: [revenueCategoryId])
  totalInCents      Int // (unitPrice * quantity - discount) + taxAmount
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())

  // Phase 9a Round 4 — credit carry-forward.
  // When this line item represents credit pulled forward from an earlier
  // auto-closed invoice (negative `unitPriceInCents`/`totalInCents`),
  // `creditFromInvoiceId` points back at the source invoice (which has its
  // `creditConsumedAt` stamped). Bidirectional audit trail.
  creditFromInvoiceId String?
  creditFromInvoice   Invoice? @relation("CreditSource", fields: [creditFromInvoiceId], references: [invoiceId])
  // Phase 9a line-item hardening — SNAPSHOT of the credit source's payer (whose
  // overpayment credit this is) so a CREDIT line can name its source person,
  // robust against a future edit-bill-to mutation changing the source's payer.
  creditFromUserId    String?
  creditFromUser      User?    @relation("LineItemCreditFromUser", fields: [creditFromUserId], references: [userId], onDelete: SetNull)

  /// Phase 12a Round 3.6 — when this CREDIT line was issued by an admin
  /// refund (vs auto-carry-forward), points at the payment that funded it.
  /// Used by refundStripePayment to reduce the refundable cap so we don't
  /// double-issue money (e.g. $50 credit + $100 Stripe refund on a $100
  /// payment would return $150). NULL for auto-carry-forward CREDIT lines.
  creditFromPaymentId String?
  creditFromPayment   InvoicePayment? @relation("CreditLineFromPayment", fields: [creditFromPaymentId], references: [paymentId], onDelete: SetNull)

  // Phase 10a — Memberships (HANDOFF #119; the period/membership-FK slots were
  // designed in the line-item hardening pass and deferred to Phase 10).
  // memberMembershipId is the MEMBERSHIP_FEE provenance FK (parallels
  // memberPackageId for PACKAGE_SALE). periodStart/periodEnd record the calendar
  // term this charge covers (e.g. Feb 15 → Mar 14) — most useful for recurring /
  // prorated membership charges. onDelete: SetNull preserves the financial line if
  // a membership row is ever removed (memberships are soft-deleted, never hard
  // DELETEd, so this is a safety net).
  memberMembershipId String?
  memberMembership   MemberMembership? @relation(fields: [memberMembershipId], references: [memberMembershipId], onDelete: SetNull)
  periodStart        DateTime?
  periodEnd          DateTime?

  // Phase 9a — provenance FK for kind = EVENT_REGISTRATION (a billable event
  // check-in with no covering package; parallels memberPackageId for
  // PACKAGE_SALE). Links the charge to the exact registration so the same
  // session can't be billed twice (idempotency) and the "needs billing"
  // detection can exclude already-charged sessions. onDelete: SetNull preserves
  // the financial line if a registration row is ever removed.
  eventRegistrationId String?
  eventRegistration   EventRegistration? @relation(fields: [eventRegistrationId], references: [registrationId], onDelete: SetNull)

  @@index([invoiceId])
  @@index([kind])
  @@index([productId])
  @@index([packagePlanId])
  @@index([memberPackageId])
  @@index([creditFromInvoiceId])
  @@index([revenueCategoryId])
  @@index([creditFromUserId])
  @@index([memberMembershipId])
  @@index([eventRegistrationId])
  @@index([creditFromPaymentId])
}

// InvoicePayment — a payment received against an invoice. Multi-processor by design:
// processor + processorTransactionId pair is unique to make webhook retries safe.
// Manual payments (cash/check) have processor = null.
model InvoicePayment {
  paymentId     String  @id @default(cuid())
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  amountInCents Int // gross amount paid (refunds tracked separately in InvoiceRefund)
  paymentMethod String  @db.VarChar(30) // "cash" | "check" | "credit_card" | "pos_transaction" | "stripe" | "paysafe" | "other"
  status        String  @default("succeeded") @db.VarChar(20) // "pending" | "succeeded" | "failed" | "refunded" | "partially_refunded" | "disputed"

  // Multi-processor extensibility (see phase9-invoicing.md)
  processor              String? @db.VarChar(30) // "stripe" | "paysafe" | "square" | "valor" | null
  processorTransactionId String? @db.VarChar(255)
  processorChargeId      String? @db.VarChar(255)
  processorFeeInCents    Int?

  reference      String?  @db.VarChar(255) // legacy/manual: check number, free-text
  notes          String?  @db.Text
  receivedBy     String // staff userId
  receivedByUser User     @relation("PaymentReceivedBy", fields: [receivedBy], references: [userId])
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  refunds     InvoiceRefund[]
  // Phase 12a Round 3.6 — CREDIT lines issued by an admin refund (refund-as-
  // credit) back-reference the funding payment via creditFromPaymentId so the
  // refundable cap math can include them. Empty for cash/check payments.
  creditLines InvoiceLineItem[] @relation("CreditLineFromPayment")

  // Webhook idempotency: same processor tx id can't be recorded twice.
  // Postgres treats multiple NULLs as distinct, so manual cash/check payments don't conflict.
  @@unique([processor, processorTransactionId])
  @@index([invoiceId])
  @@index([status])
  @@index([receivedBy])
}

// InvoiceRefund — a refund row. Separate from InvoicePayment so we can support
// partial refunds and multiple refunds per payment, with a clean audit trail.
// Sum of refunds reduces invoice.amountPaidInCents at query time.
model InvoiceRefund {
  refundId       String         @id @default(cuid())
  paymentId      String
  payment        InvoicePayment @relation(fields: [paymentId], references: [paymentId], onDelete: Cascade)
  invoiceId      String // denormalized for invoice-level queries
  invoice        Invoice        @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  amountInCents  Int // positive amount being refunded
  reason         String?        @db.VarChar(500)
  refundedBy     String // staff userId
  refundedByUser User           @relation("RefundIssuedBy", fields: [refundedBy], references: [userId])
  refundedAt     DateTime       @default(now())

  // Processor fields — null for manual refunds (handing back cash)
  processor           String? @db.VarChar(30)
  processorRefundId   String? @db.VarChar(255)
  processorFeeInCents Int? // some processors return original fee on refund, some don't

  notes     String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([processor, processorRefundId])
  @@index([paymentId])
  @@index([invoiceId])
  @@index([refundedBy])
}

// ============================================================
// MEMBERSHIPS (Phase 10a, 2026-05-26)
// See designFiles/roadmap/phase10-memberships.md (spec) +
// phase10a-build-plan.md (WP1). Driver: NVBC. Template -> instance shape mirrors
// PackagePlan -> MemberPackage. Money in Int cents (#94). Membership statuses are
// String (NOT a Prisma enum, unlike RegistrationStatus). Fixed-term, signup-
// anchored; auto-renew + calendar-aligned proration fields ship but are inert in
// 10a (no generator, no cron — expiry is computed-on-read at endDate, #27).
// Status changes audit through the shared AuditLog (Option B) via
// writeAuditedMutation (membership.* actions) — NO dedicated MembershipStatusLog.
// ============================================================

// MembershipType — a simple label + revenue category used to categorize
// memberships for reporting (e.g. "Adult Monthly", "Junior Annual"). Club-scoped
// catalog; a type can have multiple plans. Archive via isActive (#4/#51).
model MembershipType {
  membershipTypeId  String           @id @default(cuid())
  clubShortName     String
  club              Club             @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  name              String           @db.VarChar(200) // e.g., "Adult Monthly"
  revenueCategoryId String? // for financial reporting
  revenueCategory   RevenueCategory? @relation(fields: [revenueCategoryId], references: [revenueCategoryId])
  isActive          Boolean          @default(true)
  sortOrder         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  plans MembershipPlan[]

  // A club can't duplicate its own type name (decided 2026-05-26); other clubs
  // may reuse names freely.
  @@unique([clubShortName, name])
  @@index([clubShortName])
  @@index([revenueCategoryId])
}

// MembershipPlan — the detailed config of how a membership works: billing
// frequency/fee, contract length, included benefits, access rules. A type can
// have multiple plans. Period length = billingInterval + billingUnit; the billing
// ANCHOR, proration, and cancel-refund policy live in Club.membershipPreferences
// (club-level), not on the plan. Restrict-FK on used plans blocks hard-delete;
// archive via isActive (#51).
model MembershipPlan {
  membershipPlanId     String         @id @default(cuid())
  clubShortName        String
  club                 Club           @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  membershipTypeId     String
  membershipType       MembershipType @relation(fields: [membershipTypeId], references: [membershipTypeId])
  description          String         @db.VarChar(500) // e.g., "$50/month, 12-month contract"
  billingFrequency     String         @db.VarChar(20) // "monthly" | "quarterly" | "annually" | "custom"
  billingInterval      Int // number of units (e.g., 1 for monthly, 3 for quarterly)
  billingUnit          String         @db.VarChar(20) // "day" | "week" | "month" | "year"
  billingCycles        Int? // how many times to bill per contract (null = indefinite)
  feePerTermInCents    Int // recurring fee each billing cycle, in cents (#94: Int cents, never Decimal)
  initiationFeeInCents Int            @default(0) // one-time fee at signup (future)
  maxVisits            Int? // null = unlimited (future)
  // DEFAULT auto-renew for new sales of this plan. Inert in 10a (no generator).
  // Per-sale override lives on MemberMembership.autoRenew. See Auto-Renew Toggle §.
  autoRenew            Boolean        @default(false)
  sellOnline           Boolean        @default(false) // (future)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  memberMemberships MemberMembership[]

  @@index([clubShortName])
  @@index([membershipTypeId])
}

// MemberMembership — an instance of a MembershipPlan sold to a specific member.
// A member may hold MULTIPLE concurrent/overlapping memberships (no one-active
// limit) — "current membership" is always a plural query. Stored status is the
// lifecycle (active/cancelled/suspended/frozen/voided); upcoming/active/expired
// are DERIVED from startDate/endDate on read (no cron, #27). Never hard-deleted —
// void is a soft-delete. Payer is NOT stored here; it lives on the Invoice
// (billedToUserId). Beneficiary = userId (#110/#116).
model MemberMembership {
  memberMembershipId      String         @id @default(cuid())
  clubShortName           String
  club                    Club           @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  userId                  String // the beneficiary / consumer
  user                    User           @relation("MemberMembershipOwner", fields: [userId], references: [userId])
  membershipPlanId        String
  membershipPlan          MembershipPlan @relation(fields: [membershipPlanId], references: [membershipPlanId])
  // OPTIONAL facility where sold / member's home location (attribution + reporting;
  // mirrors Invoice.facilityId). null = club-wide/unattributed. Validity is
  // club-wide regardless; facility-RESTRICTED memberships are future.
  facilityId              String?
  facility                ClubFacility?  @relation(fields: [facilityId], references: [facilityId])
  membershipNumber        String? // auto-generated or manual (future)
  // STORED lifecycle: "active" | "cancelled" | "suspended" | "frozen" | "voided".
  // "upcoming"/"active"/"expired" are DERIVED from startDate/endDate on read.
  status                  String         @db.VarChar(20)
  startDate               DateTime // today or FUTURE (>= today; future -> derived "upcoming"). Backdating disallowed in 10a.
  endDate                 DateTime? // calendar term end (Feb 15 -> Mar 14); null = indefinite. Expiry computed-on-read (#27).
  nextBillingDate         DateTime? // unused in 10a (no auto-renew); set only when the generator runs (future).
  // Per-membership override of MembershipPlan.autoRenew; null = inherit plan.
  // Inert in 10a (see Auto-Renew Toggle §).
  autoRenew               Boolean?
  billingCyclesCompleted  Int            @default(0)
  freezeStartDate         DateTime? // when freeze began
  freezeEndDate           DateTime? // when freeze ends (extends endDate)
  freezeReason            String?        @db.Text
  suspendReason           String?        @db.Text
  cancelReason            String?        @db.Text
  cancelDate              DateTime?
  // Soft-delete for mistakes (wrong member/duplicate). Hides the row + voids the
  // UNPAID fee line item. If already paid -> refund + cancel instead. Admin only.
  // Never a hard DELETE.
  voidedAt                DateTime?
  voidedBy                String?
  voidReason              String?        @db.Text
  soldBy                  String // staff userId
  soldByUser              User           @relation("MemberMembershipSeller", fields: [soldBy], references: [userId])
  soldAt                  DateTime       @default(now())
  notes                   String?        @db.Text
  // Phase 12a — Stripe Connect traceability for the INITIAL purchase. 12b's
  // recurring-billing generator will populate these for renewal charges too.
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  invoiceLineItems InvoiceLineItem[]

  @@index([clubShortName])
  @@index([userId])
  @@index([membershipPlanId])
  @@index([facilityId])
  @@index([status])
  @@index([endDate])
  @@index([soldBy])
  @@index([stripePaymentIntentId])
}

// ============================================================
// EMAIL GROUPS (see designFiles/email-groups.md)
// ============================================================

// EmailGroup — a named, reusable group scoped to a facility for bulk email sends.
// Membership is dynamic (filter-based) with manual overrides.
model EmailGroup {
  emailGroupId    String       @id @default(cuid())
  clubShortName   String
  club            Club         @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  facilityId      String
  facility        ClubFacility @relation(fields: [facilityId], references: [facilityId], onDelete: Cascade)
  name            String       @db.VarChar(200)
  createdByUserId String
  createdByUser   User         @relation("EmailGroupCreator", fields: [createdByUserId], references: [userId])
  // Stored filter config: { tagIds: string[], ageMin?: number, ageMax?: number }
  filterConfig    Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  archivedAt DateTime?

  members    EmailGroupMember[]
  exclusions EmailGroupExclusion[]
  sendLogs   EmailSendLog[]

  @@index([clubShortName])
  @@index([facilityId])
  @@index([createdByUserId])
  @@index([archivedAt])
}

// EmailGroupMember — explicit membership in an email group (from filter sync or manual add)
model EmailGroupMember {
  id           String     @id @default(cuid())
  emailGroupId String
  emailGroup   EmailGroup @relation(fields: [emailGroupId], references: [emailGroupId], onDelete: Cascade)
  userId       String
  user         User       @relation("EmailGroupMemberships", fields: [userId], references: [userId], onDelete: Cascade)
  source       String     @db.VarChar(20) // "filter" | "manual"
  joinedAt     DateTime   @default(now())

  @@unique([emailGroupId, userId])
  @@index([emailGroupId])
  @@index([userId])
}

// EmailGroupExclusion — users who left or were manually removed from a group
model EmailGroupExclusion {
  id           String     @id @default(cuid())
  emailGroupId String
  emailGroup   EmailGroup @relation(fields: [emailGroupId], references: [emailGroupId], onDelete: Cascade)
  userId       String
  user         User       @relation("EmailGroupExclusions", fields: [userId], references: [userId], onDelete: Cascade)
  reason       String     @db.VarChar(20) // "left" | "removed"
  excludedAt   DateTime   @default(now())

  @@unique([emailGroupId, userId])
  @@index([emailGroupId])
  @@index([userId])
}

// EmailSendStatus — lifecycle of a group email campaign. Lowercase labels match
// the values written by the send pipeline (emailSend.ts) and the Resend webhook.
enum EmailSendStatus {
  queued
  sending
  sent
  partial_failure
  failed
}

// EmailSendLog — audit log of every email sent to a group
model EmailSendLog {
  sendLogId         String          @id @default(cuid())
  emailGroupId      String
  emailGroup        EmailGroup      @relation(fields: [emailGroupId], references: [emailGroupId], onDelete: Cascade)
  senderUserId      String
  sender            User            @relation("EmailSender", fields: [senderUserId], references: [userId])
  subject           String          @db.VarChar(500)
  bodyHtml          String          @db.Text
  bodyText          String?         @db.Text
  attachmentUrls    String[]
  resendId          String?         @db.VarChar(100)
  status            EmailSendStatus @default(sent)
  replyToEmail      String?         @db.VarChar(255)
  fromDisplayName   String?         @db.VarChar(200)
  recipientCount    Int
  skippedCount      Int             @default(0)
  skippedRecipients Json?
  errorMessage      String?         @db.Text
  // Test sends (the "Send Test to Me" button) are logged for audit/delivery
  // tracking but excluded from the user-facing send history.
  isTest            Boolean         @default(false)
  sentAt            DateTime        @default(now())

  recipients EmailSendRecipient[]

  @@index([emailGroupId])
  @@index([senderUserId])
  @@index([sentAt])
}

// EmailSendRecipient — per-recipient delivery record for a sent email
model EmailSendRecipient {
  id              String       @id @default(cuid())
  sendLogId       String
  sendLog         EmailSendLog @relation(fields: [sendLogId], references: [sendLogId], onDelete: Cascade)
  userId          String
  user            User         @relation("EmailRecipient", fields: [userId], references: [userId])
  email           String       @db.VarChar(255) // snapshot at send time
  status          String       @db.VarChar(20) // "sent" | "failed"
  resendMessageId String?      @db.VarChar(100)
  deliveredAt     DateTime?
  openedAt        DateTime?
  openCount       Int          @default(0)
  bouncedAt       DateTime?
  complainedAt    DateTime?
  error           String?      @db.Text

  @@index([sendLogId])
  @@index([userId])
  @@index([resendMessageId])
}

// Phase 9b — cached invoice PDF renders.
//
// One row per render. We never overwrite — every regeneration inserts a new
// row with version = previous + 1, so we keep an audit trail of historical
// PDFs (which member-1 saw). Only the LATEST row is exposed to consumers via
// the /api/invoices/[invoiceId]/pdf route handler.
//
// Cache invalidation is read-time:
//   serve cached row IFF
//     row.invoiceUpdatedAt == invoice.updatedAt
//     AND row.rendererVersion == CURRENT_RENDERER_VERSION (constant in code)
//   else regenerate from src/server/services/invoiceRenderer/assemble.ts
//
// The Invoice's @updatedAt already bumps on every meaningful mutation
// (sellPackage line-item add, recordPayment, closeInvoice, voidInvoice,
// refund), so no explicit cache-bust calls are needed at write sites.
model InvoicePdf {
  invoicePdfId     String   @id @default(cuid())
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  // Monotonically increasing per invoice; 1, 2, 3, …
  version          Int
  // Rendered PDF bytes. Postgres bytea, same pattern as User.profileImage,
  // Product.publicImageData, PackagePlan.publicImageData. No external object
  // store in v1 — revisit if the invoicePdf table grows past ~1 GB.
  pdfData          Bytes
  // Pre-computed for monitoring + future "is this row too big" alerts.
  byteSize         Int
  // Layout/template version — bump in code (CURRENT_RENDERER_VERSION) when the
  // PDF layout changes meaningfully so cached rows auto-regenerate on next
  // read. Free-form string so the next bump can encode anything (e.g. "v2.0").
  rendererVersion  String   @db.VarChar(30)
  // Snapshot of Invoice.updatedAt at render time. Compared with the live
  // invoice.updatedAt on read; mismatch = invoice changed since render =
  // regenerate.
  invoiceUpdatedAt DateTime
  // Whoever triggered this render (null = system, e.g. background regen).
  generatedBy      String?
  generatedByUser  User?    @relation("InvoicePdfGeneratedBy", fields: [generatedBy], references: [userId], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@unique([invoiceId, version])
  @@index([invoiceId])
  @@index([generatedBy])
}

// ============================================================
// ARTICLES (Facility Presence marketing articles, facilitypresence.com/articles)
// Distinct from the existing `Post`/`Tag`/`UserTag` models — Article-prefixed
// names avoid collisions. Images stored binary-in-Postgres (ContentImage),
// same bytea pattern as User.profileImage / InvoicePdf.pdfData.
// ============================================================

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model ContentImage {
  id            String             @id @default(cuid())
  data          Bytes
  mimeType      String             @db.VarChar(100)
  alt           String?            @db.VarChar(300)
  createdAt     DateTime           @default(now())
  // Phase 15 Step 6 — both back-relations must be NAMED because there are
  // now two distinct relations to the same model (ContentImage→Article,
  // ContentImage→ClubAnnouncement). Prisma would otherwise be ambiguous.
  articles      Article[]          @relation("ContentImageArticles")
  announcements ClubAnnouncement[] @relation("ContentImageAnnouncements")
}

model Article {
  id                 String           @id @default(cuid())
  // Phase 15 Stage 2 — null = platform article (FP brand, /articles).
  // set  = club article (club brand, /<short>/articles).
  // Scope is locked at creation (Q8): the router rejects mutation attempts.
  clubShortName      String?
  club               Club?            @relation("ClubArticles", fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  slug               String           @db.VarChar(200)
  title              String           @db.VarChar(200)
  excerpt            String?          @db.VarChar(500)
  bodyHtml           String           @db.Text
  coverImageId       String?
  coverImage         ContentImage?    @relation("ContentImageArticles", fields: [coverImageId], references: [id])
  status             ArticleStatus    @default(DRAFT)
  publishedAt        DateTime?
  metaTitle          String?          @db.VarChar(200)
  metaDescription    String?          @db.VarChar(500)
  // Phase 15 Step 5 polish (F8) — precomputed reading-time estimate, recomputed
  // by the router on every create/update that changes bodyHtml. Stored so card
  // queries don't have to ship `bodyHtml` over the wire just to display
  // "N min read". Min value 1.
  readingTimeMinutes Int              @default(1)
  authorId           String
  author             User             @relation("ArticleAuthor", fields: [authorId], references: [userId])
  tags               ArticleTagJoin[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Slug uniqueness is per-scope: platform-null slugs and per-club slugs live
  // in separate namespaces, so two clubs can both have /<short>/articles/<slug>.
  @@unique([clubShortName, slug])
  @@index([clubShortName, status, publishedAt])
  @@index([authorId])
}

model ArticleTag {
  id            String           @id @default(cuid())
  // Phase 15 Stage 2 — tag taxonomy is per-scope (platform OR per-club).
  // Decision Q5: per-club tags, no cross-club tag pool.
  clubShortName String?
  club          Club?            @relation("ClubArticleTags", fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  name          String           @db.VarChar(100)
  slug          String           @db.VarChar(100)
  articles      ArticleTagJoin[]
  createdAt     DateTime         @default(now())

  @@unique([clubShortName, slug])
  @@unique([clubShortName, name])
}

model ArticleTagJoin {
  articleId String
  tagId     String
  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       ArticleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

// ============================================================
// Phase 15 Step 6 — ClubAnnouncements
// Per-club, short-form posts surfaced as a single scrollable feed at
// /<short>/announcements. No slug, no tags, no detail URL. Authoring rules
// (collaborative edit within club — Q10) and draft visibility (Q11) live in
// ~/server/api/routers/announcements.ts.
// ============================================================

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

model ClubAnnouncement {
  id            String             @id @default(cuid())
  // Phase 15 Step 6 — announcements are ALWAYS per-club (no platform scope,
  // unlike articles). clubShortName REQUIRED at create, locked on update (Q8).
  clubShortName String
  club          Club               @relation("ClubAnnouncements", fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  title         String?            @db.VarChar(200) // optional — short posts may not need one
  bodyHtml      String             @db.Text
  coverImageId  String?
  coverImage    ContentImage?      @relation("ContentImageAnnouncements", fields: [coverImageId], references: [id])
  status        AnnouncementStatus @default(DRAFT)
  publishedAt   DateTime?
  authorId      String
  author        User               @relation("AnnouncementAuthor", fields: [authorId], references: [userId])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([clubShortName, status, publishedAt])
}

// ============================================================
// PHASE 12a — STRIPE CONNECT + GENERIC PAYMENT-PROCESSOR PLUMBING
// See designFiles/roadmap/phase12-stripe-connect.md (canonical design).
// Per-processor connection state lives in its OWN table (ClubStripeAccount now;
// ClubPaysafeAccount / ClubValorAccount later). Cross-cutting concerns
// (idempotency, customer mapping, orphan queue, checkout sessions) live in
// generic, processor-discriminated tables. A club has AT MOST one active
// processor at a time — enforced in app code by `getProviderForClub`.
// ============================================================

// ClubStripeAccount — per-club Stripe connection state. 1:1 with Club. Never
// hard-deleted; `disconnectedAt` is the soft-disconnect signal so reconnect can
// re-resume the same Stripe acct_ relationship.
model ClubStripeAccount {
  id               String    @id @default(cuid())
  clubShortName    String    @unique // 1:1 with Club in 12a
  club             Club      @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  stripeAccountId  String    @unique // acct_xxx
  livemode         Boolean // sanity-check vs incoming webhooks
  chargesEnabled   Boolean   @default(false)
  payoutsEnabled   Boolean   @default(false)
  detailsSubmitted Boolean   @default(false)
  accountEmail     String?
  defaultCurrency  String?   @db.VarChar(3)
  connectedAt      DateTime  @default(now())
  lastSyncedAt     DateTime  @default(now())
  disconnectedAt   DateTime?

  @@index([stripeAccountId])
}

// ProcessedProcessorEvent — generic webhook idempotency table. INSERT-on-
// first-touch as the FIRST DB op inside every webhook handler `$transaction`
// (Invariant I6 — do NOT hoist out of the tx for performance). Unique-violation
// = duplicate delivery → return 200 silently. Composite PK; no separate id.
model ProcessedProcessorEvent {
  processor   String   @db.VarChar(30) // 'stripe' | 'paysafe' | 'valor'
  eventId     String   @db.VarChar(255)
  processedAt DateTime @default(now())

  @@id([processor, eventId])
  @@index([processedAt])
}

// ProcessorCustomerLink — per-(user, processor, connected-account) Customer
// mapping. Webhook populates on first checkout; future SetupIntents in 12b hang
// saved cards off these rows. Multi-club person ends up with one row per
// (club's connected account); single User row.
/// 12b prep: stores the Stripe Customer ID per (user, club, processor) so
/// that Phase 12b (card-on-file + recurring billing) can charge a saved
/// card via off-session PaymentIntent without re-entering card details.
/// Currently WRITTEN in 12a (every checkout creates a Stripe Customer
/// automatically; we capture the link) but NOT READ — no 12a code uses
/// these rows. The forward-investment cost is ~5 lines in dispatch.ts;
/// migrating to 12b is just "look up the link and charge" with no backfill.
model ProcessorCustomerLink {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation("UserProcessorCustomers", fields: [userId], references: [userId], onDelete: Cascade)
  processor          String   @db.VarChar(30)
  providerAccountId  String   @db.VarChar(255) // acct_xxx for Stripe
  providerCustomerId String   @db.VarChar(255) // cus_xxx for Stripe
  createdAt          DateTime @default(now())

  @@unique([userId, processor, providerAccountId])
  @@index([providerAccountId, providerCustomerId])
}

// OrphanedPurchaseStatus — lifecycle for the dead-letter queue.
enum OrphanedPurchaseStatus {
  PENDING
  RECONCILED
  REFUNDED
  IGNORED
}

// OrphanedPurchase — generic dead-letter queue for webhook failures.
// `reason` is String, not enum, intentionally — vocabulary is extensible
// (e.g. 'no_email' | 'clerk_create_failed' | 'seat_filled_pre_webhook'
//  | 'stripe_dashboard_refund_with_consumed_credit' | 'unknown_club'
//  | 'unknown_metadata' | 'duplicate_attach').
model OrphanedPurchase {
  id                      String                 @id @default(cuid())
  clubShortName           String
  club                    Club                   @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  processor               String                 @db.VarChar(30)
  providerSessionId       String?                @db.VarChar(255)
  providerPaymentIntentId String?                @db.VarChar(255)
  email                   String?
  reason                  String                 @db.VarChar(60)
  status                  OrphanedPurchaseStatus @default(PENDING)
  rawEvent                Json
  notes                   String?                @db.Text
  resolvedAt              DateTime?
  resolvedBy              String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([clubShortName, status])
  @@index([processor, providerSessionId])
}

// CheckoutSession — local mirror of provider checkout sessions. Used to:
//   (a) render `/checkout/[sessionId]` page from a stable cuid we control;
//   (b) let the webhook look up the local `intent` via
//       `metadata.checkoutSessionId = CheckoutSession.id` to dispatch by itemKind.
// The Stripe payload is the canonical source of truth on amount/email/customer;
// `intent` here is read-only audit/debug.
model CheckoutSession {
  id                String   @id @default(cuid()) // used in /checkout/[id]
  clubShortName     String
  club              Club     @relation(fields: [clubShortName], references: [clubShortName], onDelete: Cascade)
  processor         String   @db.VarChar(30)
  providerSessionId String   @unique // cs_xxx for Stripe
  providerAccountId String // acct_xxx
  clientSecret      String   @db.Text // Stripe Embedded Checkout client_secret
  amountInCents     Int
  description       String   @db.VarChar(500)
  intent            Json // serialized CheckoutIntent — read-only audit/debug
  status            String   @default("open") @db.VarChar(20)
  // "open" | "completed" | "expired" | "failed"
  // (Round 3.6 N5 — 'failed' replaces 'voided' to match dispatch code.)
  consumerUserId    String?
  // Phase 12a Round 2.7.1 — the user who clicked "Pay" (actor), as opposed to
  // `consumerUserId` (beneficiary). Null for guest/public-shop checkouts.
  // Drives the §7.8.13 "Resume checkout" banner so a parent paying for a kid
  // sees their own row instead of the kid's. SetNull on user delete: we keep
  // the audit/debug row but stop attributing it to a deleted actor.
  initiatedByUserId String?
  initiatedByUser   User?    @relation("CheckoutSessionInitiator", fields: [initiatedByUserId], references: [userId], onDelete: SetNull)
  invoiceId         String? // pay-now case
  // Phase 12a Round 2.7.1 — explicit expiry mirroring the Stripe session's
  // `expires_at` (set to createdAt + 30 min on insert). The §7.8.13 banner
  // query filters `expiresAt > now()` so stale rows never display even when
  // their status stays 'open' (no cron in 12a — deferred).
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([clubShortName, status])
  @@index([providerSessionId])
  @@index([initiatedByUserId])
}

/// Phase 12a interim store for Stripe (and future processor) configuration
/// values when env vars can't be set (e.g., owner traveling without SSH
/// access). The env-var path takes priority: code calls getPlatformConfig()
/// and only consults this table when process.env.<KEY> is blank/missing.
/// When env vars are restored, DB rows here should be removed.
///
/// Security note: values are stored plaintext. Do not put live-mode secrets
/// here for production; this is intended for test-mode keys + dev/staging
/// emergencies. Access via Prisma Studio is gated by platform-admin auth.
model PlatformConfig {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String? // userId or null for system

  @@map("PlatformConfig")
}
